<?xml version="1.0" encoding="utf-8"?>
<!--
  web.config del BACKEND. Va en la carpeta del backend en el servidor, que se publica en
  IIS como una aplicación bajo la ruta /api del sitio.

  Cómo funciona: HttpPlatformHandler arranca el proceso de Python, le asigna un puerto
  libre (%HTTP_PLATFORM_PORT%) y le reenvía las peticiones. IIS se encarga del ciclo de
  vida — lo levanta al primer pedido, lo reinicia si se cae, lo recicla con el pool.

  Por qué HttpPlatformHandler y no ARR: ARR necesita dos módulos (Application Request
  Routing + URL Rewrite) y deja el proceso de Python por fuera de IIS, corriendo como un
  servicio aparte que alguien tiene que arrancar y vigilar. Con este módulo es un solo
  componente y el proceso vive y muere con el sitio.

  REQUISITO: el módulo HttpPlatformHandler v1.2 tiene que estar instalado en el servidor
  (https://www.iis.net/downloads/microsoft/httpplatformhandler). `publicar.ps1` lo
  verifica antes de hacer nada.

  Las rutas absolutas las reescribe `publicar.ps1` según dónde se instale.
-->
<configuration>
  <system.webServer>
    <handlers>
      <!-- Se quita cualquier manejador heredado del sitio padre: sin esto, IIS podría
           intentar servir los archivos .py como texto plano. -->
      <clear />
      <add name="httpPlatformHandler"
           path="*"
           verb="*"
           modules="httpPlatformHandler"
           resourceType="Unspecified"
           requireAccess="Script" />
    </handlers>

    <httpPlatform processPath="__RUTA_PYTHON__"
                  arguments="-m waitress --host=127.0.0.1 --port=%HTTP_PLATFORM_PORT% --threads=8 --channel-timeout=120 config.wsgi:application"
                  stdoutLogEnabled="true"
                  stdoutLogFile="__RUTA_LOGS__\backend"
                  startupTimeLimit="120"
                  startupRetryCount="3"
                  requestTimeout="00:10:00"
                  processesPerApplication="1">
      <environmentVariables>
        <environmentVariable name="DJANGO_SETTINGS_MODULE" value="config.settings" />
        <!-- Sin esto la salida queda en el búfer y el log del servidor llega tarde o
             incompleto, justo cuando hace falta para diagnosticar algo. -->
        <environmentVariable name="PYTHONUNBUFFERED" value="1" />
        <!-- El proceso que arranca IIS usa la página de códigos OEM del sistema, no
             UTF-8: sin esto, un traceback con acentos llega ilegible. -->
        <environmentVariable name="PYTHONIOENCODING" value="utf-8" />
      </environmentVariables>
    </httpPlatform>

    <!-- Django ya aplica sus propias cabeceras de seguridad; se quitan las que delatan
         la versión del servidor. -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering>
        <!-- 25 MB, el mismo tope que UPLOAD_MAX_SIZE_BYTES en el .env. Si uno cambia,
             el otro también: IIS corta la petición antes de que Django la vea, y el
             usuario recibiría un error genérico en vez del mensaje de la aplicación. -->
        <requestLimits maxAllowedContentLength="26214400" />
        <!-- El código fuente y la configuración no se sirven nunca por HTTP, aunque el
             manejador de arriba ya los intercepte. Defensa en profundidad. -->
        <hiddenSegments>
          <add segment=".venv" />
          <add segment="logs" />
          <add segment="__pycache__" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".env" allowed="false" />
          <add fileExtension=".py" allowed="false" />
          <add fileExtension=".pyc" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
