# DEBUG por defecto es False y SECRET_KEY no tiene valor de respaldo: con DEBUG=False el
# arranque falla si SECRET_KEY o JWT_SECRET_KEY no están definidas o siguen con un valor de
# ejemplo. Generá cada una con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# Solo detrás de un proxy/balanceador que termina TLS (evita el bucle de SECURE_SSL_REDIRECT).
USE_X_FORWARDED_PROTO=False

DB_ENGINE=mssql
DB_NAME=cms_dashboards
DB_USER=sa
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=1433
# Los defaults del código son Encrypt=yes / TrustServerCertificate=no. Estos valores de
# desarrollo los relajan a propósito para un SQL Server local sin certificado válido.
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes
# pyodbc busca el driver por su nombre EXACTO, y la version instalada cambia segun la
# maquina. Si el servidor tiene el 18 en vez del 17, se declara aca en vez de instalar
# una version vieja. Para ver cuales hay: Get-OdbcDriver (PowerShell).
# Lo usan la base propia y la conexion externa de solo lectura.
DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

UPLOAD_MAX_SIZE_BYTES=26214400

# --- Conexión externa de solo lectura (Conectar vista de base de datos) -----
# Conexión "por defecto" hacia una base productiva de origen — separada de DB_* de arriba (que es
# la base propia de esta app). Sin EXTERNAL_DB_HOST, el botón "Conectar vista de base de datos"
# responde con un error de negocio claro en vez de intentar conectar a algo sin configurar.
EXTERNAL_DB_HOST=
EXTERNAL_DB_PORT=1433
EXTERNAL_DB_NAME=
EXTERNAL_DB_USER=
EXTERNAL_DB_PASSWORD=change-me
# A DIFERENCIA de DB_ENCRYPT: la base externa no es local, la conexión cruza la red, así que sus
# credenciales viajarían en claro con Encrypt=no. Se deja en `yes` — comprobado que un SQL Server
# con certificado autofirmado acepta la conexión cifrada igual, siempre que se siga confiando en su
# certificado (`TRUST_SERVER_CERTIFICATE=yes`). Eso protege de la escucha pasiva; para protegerse
# también de un intermediario activo hace falta un certificado emitido por una CA de confianza y
# entonces sí `TRUST_SERVER_CERTIFICATE=no`.
EXTERNAL_DB_ENCRYPT=yes
EXTERNAL_DB_TRUST_SERVER_CERTIFICATE=yes

# --- Autenticación JWT (apps.authentication) --------------------------------
JWT_SECRET_KEY=change-me
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ALGORITHM=HS256

# SEC-19: el refresh token viaja en una cookie `HttpOnly`, no en el cuerpo de la respuesta.
# `Lax` alcanza mientras el frontend se sirva desde el mismo sitio que la API (el proxy de Vite en
# desarrollo, o un nginx único en producción). Si el frontend vive en otro dominio hay que poner
# `None`, y `None` EXIGE HTTPS: sin `Secure` el navegador descarta la cookie y nadie puede refrescar.
REFRESH_COOKIE_SAMESITE=Lax
# Por defecto sigue a DEBUG (seguro fuera de desarrollo). Solo se fija a mano para un caso raro,
# como servir por HTTP detrás de un proxy que termina TLS sin informarlo.
# REFRESH_COOKIE_SECURE=True
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Fallos acumulados por IP en la misma ventana, para detectar el rociado de una contraseña
# contra muchas cuentas (el conteo por cuenta no lo ve). 0 lo desactiva.
LOGIN_MAX_FAILED_ATTEMPTS_PER_IP=30
# Límite de TASA del login por IP (los throttles quedan desactivados durante manage.py test).
LOGIN_THROTTLE_RATE=60/min

# --- Correo / recuperación de contraseña (apps.authentication, Módulo D) -------
# Por defecto (sin configurar nada abajo) los correos se imprimen en la consola del servidor —
# nunca se envía correo real sin configurar EMAIL_BACKEND explícitamente. Nunca commitear
# credenciales reales en este archivo ni en .env.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=no-reply@cms-dashboards.local
# Nunca hardcodear el dominio del enlace de recuperación — siempre se arma desde esta variable.
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_LIFETIME_MINUTES=30
PASSWORD_RESET_THROTTLE_RATE=5/hour

# --- Interpretación completa del dashboard (IA, Gemini) ----------------------
# Sin configurar GEMINI_API_KEY, el botón "Interpretación completa" responde con un error de
# negocio claro (IA_NO_CONFIGURADA) en vez de intentar una llamada externa.
GEMINI_API_KEY=change-me
GEMINI_MODEL=gemini-flash-latest
# Tope de llamadas a la IA por usuario/hora: cada una cuesta dinero y ocupa un hilo del
# servidor hasta 45 s. Los hallazgos además se cachean por contenido del prompt.
IA_THROTTLE_RATE=20/hour
